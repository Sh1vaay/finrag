# ==============================================================================
# FINRAG AGENT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ==============================================================================
# 1. LLM CONFIGURATION & MODEL PLACEHOLDERS
# ==============================================================================
# Select your LLM strategy mode:
#   - "placeholder"   : Dry-run / mock mode (tests pipeline graph without API keys or models)
#   - "open_source"   : Route all LLM calls to your open-source endpoint (Ollama, vLLM, etc.)
#   - "closed_source" : Route all LLM calls to your chosen commercial provider (OpenAI, Anthropic, etc.)
#   - "hybrid"        : Default production strategy (Groq fast-path + Claude/OpenAI generator)
LLM_PROVIDER_TYPE=hybrid

# --- [OPTION A] OPEN-SOURCE / LOCAL LLM PLACEHOLDERS ---
# Point to your local Ollama, vLLM, LM Studio, LocalAI, or any OpenAI-compatible server.
# Examples:
#   Ollama:   OPEN_SOURCE_LLM_BASE_URL=http://localhost:11434/v1
#   vLLM:     OPEN_SOURCE_LLM_BASE_URL=http://localhost:8000/v1
#   LMStudio: OPEN_SOURCE_LLM_BASE_URL=http://localhost:1234/v1
OPEN_SOURCE_LLM_BASE_URL=http://localhost:11434/v1
OPEN_SOURCE_LLM_MODEL=llama3.3:70b
OPEN_SOURCE_LLM_API_KEY=placeholder-key

# --- [OPTION B] CLOSED-SOURCE LLM PLACEHOLDERS ---
# Set CLOSED_SOURCE_LLM_PROVIDER to "openai" or "anthropic"
CLOSED_SOURCE_LLM_PROVIDER=openai
CLOSED_SOURCE_LLM_MODEL=gpt-4o-mini
CLOSED_SOURCE_LLM_API_KEY=

# --- [OPTION C] COMMERCIAL API KEYS ---
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GROQ_API_KEY=gsk_your-groq-key-here
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=

# Optional: Voyage AI finance-tuned embeddings
VOYAGE_API_KEY=pa-your-voyage-key-here

# --- LLM Behavior & Overrides ---
# Route all LLM calls through OpenAI (bypasses other providers during bulk runs)
FORCE_OPENAI_ONLY=false
# Use Groq for high-volume fast-path nodes (router, grader, query_rewriter)
USE_GROQ_FAST_PATH=false

# ==============================================================================
# 2. EMBEDDINGS & RETRIEVAL
# ==============================================================================
# Default: OpenAI text-embedding-3-small (1536-dim)
# Supported options:
#   openai:       EMBEDDING_PROVIDER=openai / EMBEDDING_MODEL=text-embedding-3-small / EMBEDDING_DIMENSIONS=1536
#   openai-large: EMBEDDING_PROVIDER=openai / EMBEDDING_MODEL=text-embedding-3-large / EMBEDDING_DIMENSIONS=3072
#   voyage:       EMBEDDING_PROVIDER=voyage / EMBEDDING_MODEL=voyage-finance-2 / EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Number of initial candidate chunks retrieved before reranking
RETRIEVAL_TOP_K=25
ENABLE_DETERMINISTIC_VALIDATOR=true
VALIDATOR_MIN_KEEP=3
ENABLE_LTR_GATE=false
LTR_GATE_MODEL_PATH=data/models/ltr_gate.json
LTR_GATE_HIGH_CONFIDENCE=0.9
LTR_GATE_LOW_CONFIDENCE=0.1
ENABLE_SELECTIVE_RETRIEVAL_EVALUATOR=false
RETRIEVAL_EVALUATOR_MIN_CONFIDENCE=0.55

# Multi-HyDE hypothetical passage expansion
ENABLE_MULTI_HYDE=false
MULTI_HYDE_N=3
MULTI_HYDE_MODEL=gpt-4o-mini
MULTI_HYDE_TEMPERATURE=0.3

# ==============================================================================
# 3. OBSERVABILITY & TRACING
# ==============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=rag-agent-dev
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key-here

# ==============================================================================
# 4. AUTHENTICATION & SECURITY
# ==============================================================================
JWT_SECRET=change-this-to-a-random-secret-in-production

# PII Detection (spaCy)
# Uses en_core_web_md by default (~33 MB). Set USE_LARGE_SPACY_MODEL=true for en_core_web_lg
USE_LARGE_SPACY_MODEL=false

# ==============================================================================
# 5. VECTOR STORE (QDRANT) & STORAGE
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=financial_docs

# Documents root for citation clickthrough
DOCUMENTS_ROOT=data/sample

# PostgreSQL (for LangGraph checkpoints and conversation history)
POSTGRES_DB=rag_agent
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-this-in-production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==============================================================================
# 6. GATEWAY & CACHING
# ==============================================================================
# LiteLLM proxy gateway (leave empty for direct-provider mode)
# In Docker compose: http://litellm:4000 | Host-based dev: http://localhost:4000
LITELLM_URL=

# Redis semantic cache (used by LiteLLM)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Tracing & Observability backend (phoenix | langfuse | none)
TRACING_BACKEND=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=finrag-investment

# Langfuse observability stack
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse internal secrets (override in production)
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_PG_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_USER=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_INIT_USER_PASSWORD=

# Sub-component Redis result cache
RAG_RESULT_CACHE_ENABLED=1
RESULT_CACHE_REDIS_HOST=localhost
RESULT_CACHE_REDIS_PORT=6380
RESULT_CACHE_REDIS_DB=1
RAG_RESULT_CACHE_TTL_SECONDS=604800

# ==============================================================================
# 7. APPLICATION & RUNTIME
# ==============================================================================
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3002","http://localhost:7860"]

# Hardware placement for cross-encoder reranker: cpu | mps | cuda
RERANKER_DEVICE=cpu

# Optional LoRA reranker adapter path (empty uses stock BGE reranker)
# RERANKER_ADAPTER_PATH=data/models/reranker_ft_v1

# Security guardrails
LLM_GUARD_USE_ONNX=1
RAG_DISABLE_LLM_GUARD=0

# ==============================================================================
# 8. INSTITUTIONAL QUANTITATIVE SUITE & SYSTEM 1 TRIAGE
# ==============================================================================
# Dual-System Cognitive Architecture (System 1 fast SLM decider)
# When online, StrandDecider2B delegates intent & complexity to an OpenAI-compatible
# local SLM endpoint (e.g. Ollama, vLLM) with sub-ms deterministic fallback.
DECIDER_2B_BASE_URL=http://localhost:11434/v1
DECIDER_2B_MODEL=strand-decider-2b

# Financial Market Data Feed Provider
# Options:
#   "institutional" : High-precision B-PIPE / FactSet simulation (MIC codes, sub-penny spread, VWAP)
#   "yfinance"      : Development Yahoo Finance scraper fallback
MARKET_DATA_PROVIDER=institutional

# SEC EDGAR Audited XBRL API Integration
# SEC requires specific User-Agent format: SampleCompany AdminContact@<sample company domain>.com
SEC_EDGAR_USER_AGENT=FinRAG-AssetManagement/1.0 (compliance@finrag-institutional.com)
